# Environment variables for RetailPulse

# Database Connection (Neon PostgreSQL in production, SQLite default for local development)
# Local SQLite default:
DATABASE_URL=sqlite:///./retailpulse.db

# Production Neon PostgreSQL example:
# DATABASE_URL=postgresql://user:password@ep-xyz.us-east-2.aws.neon.tech/retailpulse?sslmode=require

# Application Settings
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
